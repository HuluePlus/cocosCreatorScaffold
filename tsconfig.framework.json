{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "assets/framework/core/**/*.ts",
    "assets/framework/platform/**/*.ts",
    "assets/framework/utils/**/*.ts",
    "assets/examples/configs/**/*.ts",
    "assets/examples/core/DemoStateMachine.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
